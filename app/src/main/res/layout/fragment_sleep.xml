<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true"
    android:background="#99d98c">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp"
        android:gravity="center_horizontal">

        <TextView
            android:id="@+id/textCurrentTime"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Şu anda saat: 00:00"
            android:textSize="22sp"
            android:textStyle="bold"
            android:textColor="#000000"
            android:layout_marginTop="24dp"
            android:layout_marginBottom="8dp"/>

        <TextView
            android:id="@+id/textNowLabel"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Şimdi uyursam saat kaçta kalkmalıyım?"
            android:textSize="16sp"
            android:textColor="#000000"
            android:gravity="center_horizontal"
            android:layout_marginBottom="24dp"/>

        <!-- Uyku Döngüsü Kartları -->
        <LinearLayout
            android:id="@+id/layoutCycles"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <!-- Kestirme -->
            <androidx.cardview.widget.CardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="12dp"
                app:cardCornerRadius="12dp"
                app:cardElevation="4dp">
                <RelativeLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:padding="16dp">
                    <LinearLayout
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:layout_alignParentStart="true"
                        android:layout_toStartOf="@id/btnNap">
                        <TextView
                            android:id="@+id/textNapTime"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="00:00"
                            android:textSize="25sp"
                            android:textStyle="bold"
                            android:textColor="#000000"/>
                        <TextView
                            android:id="@+id/textNapLabel"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Kestirme (25 dk)"
                            android:textSize="15sp"
                            android:textColor="#555555"/>
                    </LinearLayout>
                    <Button
                        android:id="@+id/btnNap"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_alignParentEnd="true"
                        android:layout_centerVertical="true"
                        android:text="Alarm Kur"
                        android:backgroundTint="#1976D2"
                        android:textColor="@android:color/white"/>
                </RelativeLayout>
            </androidx.cardview.widget.CardView>

            <!-- Döngü 1 -->
            <androidx.cardview.widget.CardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="12dp"
                app:cardCornerRadius="12dp"
                app:cardElevation="4dp">
                <RelativeLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:padding="16dp">
                    <LinearLayout
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:layout_alignParentStart="true"
                        android:layout_toStartOf="@id/btnCycle1">
                        <TextView
                            android:id="@+id/textCycle1Time"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="00:00"
                            android:textSize="25sp"
                            android:textStyle="bold"
                            android:textColor="#000000"/>
                        <TextView
                            android:id="@+id/textCycle1Label"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="1 Döngü (1s 45dk)"
                            android:textSize="15sp"
                            android:textColor="#555555"/>
                    </LinearLayout>
                    <Button
                        android:id="@+id/btnCycle1"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_alignParentEnd="true"
                        android:layout_centerVertical="true"
                        android:text="Alarm Kur"
                        android:backgroundTint="#1976D2"
                        android:textColor="@android:color/white"/>
                </RelativeLayout>
            </androidx.cardview.widget.CardView>

            <!-- Döngü 2 -->
            <androidx.cardview.widget.CardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="12dp"
                app:cardCornerRadius="12dp"
                app:cardElevation="4dp">
                <RelativeLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:padding="16dp">
                    <LinearLayout
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:layout_alignParentStart="true"
                        android:layout_toStartOf="@id/btnCycle2">
                        <TextView
                            android:id="@+id/textCycle2Time"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="00:00"
                            android:textSize="25sp"
                            android:textStyle="bold"
                            android:textColor="#000000"/>
                        <TextView
                            android:id="@+id/textCycle2Label"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="2 Döngü (3s 15dk)"
                            android:textSize="15sp"
                            android:textColor="#555555"/>
                    </LinearLayout>
                    <Button
                        android:id="@+id/btnCycle2"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_alignParentEnd="true"
                        android:layout_centerVertical="true"
                        android:text="Alarm Kur"
                        android:backgroundTint="#1976D2"
                        android:textColor="@android:color/white"/>
                </RelativeLayout>
            </androidx.cardview.widget.CardView>

            <!-- Döngü 3 -->
            <androidx.cardview.widget.CardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="12dp"
                app:cardCornerRadius="12dp"
                app:cardElevation="4dp">
                <RelativeLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:padding="16dp">
                    <LinearLayout
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:layout_alignParentStart="true"
                        android:layout_toStartOf="@id/btnCycle3">
                        <TextView
                            android:id="@+id/textCycle3Time"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="00:00"
                            android:textSize="25sp"
                            android:textStyle="bold"
                            android:textColor="#000000"/>
                        <TextView
                            android:id="@+id/textCycle3Label"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="3 Döngü (4s 45dk)"
                            android:textSize="15sp"
                            android:textColor="#555555"/>
                    </LinearLayout>
                    <Button
                        android:id="@+id/btnCycle3"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_alignParentEnd="true"
                        android:layout_centerVertical="true"
                        android:text="Alarm Kur"
                        android:backgroundTint="#1976D2"
                        android:textColor="@android:color/white"/>
                </RelativeLayout>
            </androidx.cardview.widget.CardView>

            <!-- Döngü 4 -->
            <androidx.cardview.widget.CardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="12dp"
                app:cardCornerRadius="12dp"
                app:cardElevation="4dp">
                <RelativeLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:padding="16dp">
                    <LinearLayout
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:layout_alignParentStart="true"
                        android:layout_toStartOf="@id/btnCycle4">
                        <TextView
                            android:id="@+id/textCycle4Time"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="00:00"
                            android:textSize="25sp"
                            android:textStyle="bold"
                            android:textColor="#000000"/>
                        <TextView
                            android:id="@+id/textCycle4Label"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="4 Döngü (6s 15dk)"
                            android:textSize="15sp"
                            android:textColor="#555555"/>
                    </LinearLayout>
                    <Button
                        android:id="@+id/btnCycle4"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_alignParentEnd="true"
                        android:layout_centerVertical="true"
                        android:text="Alarm Kur"
                        android:backgroundTint="#1976D2"
                        android:textColor="@android:color/white"/>
                </RelativeLayout>
            </androidx.cardview.widget.CardView>

            <!-- Döngü 5 -->
            <androidx.cardview.widget.CardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="12dp"
                app:cardCornerRadius="12dp"
                app:cardElevation="4dp">
                <RelativeLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:padding="16dp">
                    <LinearLayout
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:layout_alignParentStart="true"
                        android:layout_toStartOf="@id/btnCycle5">
                        <TextView
                            android:id="@+id/textCycle5Time"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="00:00"
                            android:textSize="25sp"
                            android:textStyle="bold"
                            android:textColor="#000000"/>
                        <TextView
                            android:id="@+id/textCycle5Label"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="5 Döngü (7s 45dk)"
                            android:textSize="15sp"
                            android:textColor="#555555"/>
                    </LinearLayout>
                    <Button
                        android:id="@+id/btnCycle5"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_alignParentEnd="true"
                        android:layout_centerVertical="true"
                        android:text="Alarm Kur"
                        android:backgroundTint="#1976D2"
                        android:textColor="@android:color/white"/>
                </RelativeLayout>
            </androidx.cardview.widget.CardView>

            <!-- Döngü 6 -->
            <androidx.cardview.widget.CardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="12dp"
                app:cardCornerRadius="12dp"
                app:cardElevation="4dp">
                <RelativeLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:padding="16dp">
                    <LinearLayout
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:layout_alignParentStart="true"
                        android:layout_toStartOf="@id/btnCycle6">
                        <TextView
                            android:id="@+id/textCycle6Time"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="00:00"
                            android:textSize="25sp"
                            android:textStyle="bold"
                            android:textColor="#000000"/>
                        <TextView
                            android:id="@+id/textCycle6Label"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="6 Döngü (9s 15dk)"
                            android:textSize="15sp"
                            android:textColor="#555555"/>
                    </LinearLayout>
                    <Button
                        android:id="@+id/btnCycle6"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_alignParentEnd="true"
                        android:layout_centerVertical="true"
                        android:text="Alarm Kur"
                        android:backgroundTint="#1976D2"
                        android:textColor="@android:color/white"/>
                </RelativeLayout>
            </androidx.cardview.widget.CardView>

        </LinearLayout>
    </LinearLayout>
</ScrollView>