<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true"
    android:background="#52b69a">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="20dp"
        android:layout_marginTop="20dp">

        <TextView
            android:id="@+id/tvTitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Vücut Kitle Endeksi (BMI)"
            android:textSize="22sp"
            android:textStyle="bold"
            android:layout_marginBottom="16dp"
            android:textColor="#000000"/>

        <TextView
            android:id="@+id/tvSummary"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Boy/Kilo bilgileri"
            android:textSize="16sp"
            android:layout_marginBottom="12dp"
            android:textColor="#000000"/>

        <TextView
            android:id="@+id/tvBmi"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="VKİ: -"
            android:textSize="28sp"
            android:textStyle="bold"
            android:layout_marginBottom="8dp"
            android:textColor="#000000"/>

        <TextView
            android:id="@+id/tvCategory"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Durum: -"
            android:textSize="18sp"
            android:layout_marginBottom="6dp"
            android:textColor="#000000"/>

        <!-- VKİ Görsel Bar -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:layout_marginBottom="16dp"
            android:layout_marginTop="8dp">

            <FrameLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content">

                <!-- Arka Plan Renk Skalası -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="15dp"
                    android:orientation="horizontal"
                    android:layout_marginTop="10dp"
                    android:weightSum="40">
                    <View android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="18.5" android:background="#FFEB3B" /> <!-- Zayıf -->
                    <View android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="6.5" android:background="#4CAF50" />  <!-- Normal -->
                    <View android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="5" android:background="#FF9800" />    <!-- Fazla Kilolu -->
                    <View android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="10" android:background="#F44336" />   <!-- Obez -->
                </LinearLayout>

                <!-- İmleç (SeekBar kullanarak) -->
                <SeekBar
                    android:id="@+id/bmiSeekBar"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:max="40"
                    android:progress="0"
                    android:paddingStart="0dp"
                    android:paddingEnd="0dp"
                    android:thumbOffset="0dp"
                    android:splitTrack="false"
                    android:progressDrawable="@android:color/transparent"
                    android:enabled="false" />
            </FrameLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:weightSum="40"
                android:layout_marginTop="4dp">
                <TextView android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="18.5" android:text="18.5" android:textSize="10sp" android:gravity="end" android:textColor="#000000"/>
                <TextView android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="6.5" android:text="25" android:textSize="10sp" android:gravity="end" android:textColor="#000000"/>
                <TextView android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="5" android:text="30" android:textSize="10sp" android:gravity="end" android:textColor="#000000"/>
                <TextView android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="10" android:text="40+" android:textSize="10sp" android:gravity="end" android:textColor="#000000"/>
            </LinearLayout>
        </LinearLayout>

        <TextView
            android:id="@+id/tvIdeal"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="İdeal kilo aralığı: -"
            android:textSize="16sp"
            android:layout_marginBottom="8dp"
            android:textColor="#000000"/>

        <TextView
            android:id="@+id/tvWeightDiff"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text=""
            android:textSize="16sp"
            android:layout_marginBottom="16dp"
            android:textColor="#000000"
            android:textStyle="italic"/>

        <TextView
            android:id="@+id/tvBmr"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="BMR: -"
            android:textSize="16sp"
            android:layout_marginBottom="12dp"
            android:textColor="#000000"/>

        <TextView
            android:id="@+id/tvAdvice"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Tavsiye: -"
            android:textSize="16sp"
            android:layout_marginBottom="24dp"
            android:textColor="#000000"
            android:padding="10dp"
            android:background="#33FFFFFF"/>

    </LinearLayout>
</ScrollView>